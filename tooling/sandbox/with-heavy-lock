#!/usr/bin/env bash
# with-heavy-lock — run a CPU/RAM-heavy command under a machine-global BOUNDED
# CONCURRENCY semaphore, so parallel agent sessions queue instead of exhausting
# memory. Up to $KEEL_HEAVY_SLOTS heavy ops run at once; the rest wait their turn.
#
# WHY BOUNDED AND NOT A MUTEX: the original version of this wrapper held a single
# machine-global mutex — one heavy op at a time, machine-wide. On a box running
# ~16 agent sessions that serialized everything and was retired for throughput
# (keel de407e3, 2026-08-28). Removing it reintroduced the failure it existed to
# prevent: macOS "Your system has run out of application memory".
#
# THE NUMBER, derived by measurement on a 24 GB Apple Silicon machine
# (2026-09-04, 16 live sessions):
#   physical                                    24.0 GB
#   - wired (OS, non-swappable)                  2.78 GB
#   - agent CLI sessions (~0.22 GB x 16)         3.5  GB
#   - desktop app + renderers                    1.0  GB
#   - other user apps at the OOM moment          4.8  GB
#   = floor                                     ~12.1 GB
#   usable, leaving ~15% for cache/compressor   ~20.4 GB
#   => heavy-op budget                           ~8.3 GB
#   measured per heavy op (cdk synth / vitest): 0.44-1.43 GB (median 0.53)
#   => 3 slots x 1.43 GB worst case              ~4.3 GB  <- fits, with headroom
#      for the session count roughly doubling before the budget is threatened.
# Raise KEEL_HEAVY_SLOTS knowingly: each extra slot costs up to ~1.5 GB of peak.
#
# A hook cannot do this job: it runs BEFORE the command and exits, so it can only
# check-and-refuse, never HOLD a slot for the command's lifetime. This wrapper
# holds its slot via an inherited fd for the whole command; the kernel releases it
# the instant the process exits — including a runner that SIGSEGVs on teardown —
# so a crash can never wedge a slot.
#
# Usage:   with-heavy-lock npx vitest run path/to.test.ts
#          with-heavy-lock pnpm --filter @acme/backend build
#          with-heavy-lock npx cdk synth
#
# Composable: nested heavy ops see KEEL_HEAVY_LOCK_HELD=1 and skip re-acquiring,
# so wrapping a command that itself self-locks will not deadlock.
#
# CONFIG
#   KEEL_HEAVY_SLOTS      concurrent slots (default 3)
#   KEEL_HEAVY_LOCK_DIR   slot-file dir   (default ~/.keel/heavy.slots)
#   KEEL_HEAVY_MAX_HEAP   per-op V8 heap ceiling in MB (default 2048; 0 disables).
#                         Bounds the worst case so slots x heap is predictable.
#                         2048 sits above the measured 1.43 GB peak, so nothing
#                         that runs today starts OOM-crashing.
#   KEEL_HEAVY_WAIT_MAX   seconds to queue before offering the CI hand-off
#                         (default 180; 0 = queue forever, the old behaviour).
#   KEEL_CI_DEFER_BUDGET  CI hand-offs allowed per window, machine-wide
#                         (default 3). Spent budget => queue instead.
#   KEEL_CI_DEFER_WINDOW  rolling window for that budget in seconds (default 3600).
#
# THE CI HAND-OFF, AND WHY IT IS BOUNDED: queueing protects RAM but stalls the
# session holding the queue -- with slots saturated, a session can sit idle for
# minutes doing nothing else. So after KEEL_HEAVY_WAIT_MAX the wrapper stops
# waiting and exits 75 (EX_TEMPFAIL) telling the caller to hand this run to CI
# and get on with other work, which is what keeps parallel sessions moving.
#
# The predecessor deliberately refused to say "push to CI", calling it the
# anti-pattern that just moves the cost -- and unbounded, it is. Hence a
# machine-global ROLLING BUDGET (default 3 per hour, shared across every
# session): enough to unstick a genuinely saturated machine, not enough to
# relocate the whole test load onto CI. When the budget is spent the wrapper
# goes back to queueing, so the ceiling is on CI spend, not just on RAM.
#
# The wrapper NEVER pushes anything itself. It grants permission and prints the
# reason; committing and pushing stay the caller's explicit act.
set -uo pipefail

[ $# -gt 0 ] || { echo "usage: with-heavy-lock <command> [args...]" >&2; exit 2; }

# An ancestor already holds a slot -> just run (deadlock guard).
if [ "${KEEL_HEAVY_LOCK_HELD:-}" = "1" ]; then
  exec "$@"
fi

SLOTS="${KEEL_HEAVY_SLOTS:-3}"
case "$SLOTS" in ''|*[!0-9]*) SLOTS=3 ;; esac
[ "$SLOTS" -lt 1 ] && SLOTS=1

LKDIR="${KEEL_HEAVY_LOCK_DIR:-$HOME/.keel/heavy.slots}"
mkdir -p "$LKDIR" 2>/dev/null || true

# Resolve flock: PATH first, then the common Homebrew location, since hook and
# launchd environments routinely have a reduced PATH. FAIL OPEN if truly absent —
# a missing flock must not block the user's command, but say so once, because a
# silently no-op'd lock is exactly how the old version became invisible.
FLOCK="$(command -v flock 2>/dev/null || true)"
[ -z "$FLOCK" ] && [ -x /opt/homebrew/bin/flock ] && FLOCK=/opt/homebrew/bin/flock
[ -z "$FLOCK" ] && [ -x /usr/local/bin/flock ]    && FLOCK=/usr/local/bin/flock
if [ -z "$FLOCK" ]; then
  echo "with-heavy-lock: flock not found — running UNSERIALIZED (install: brew install flock)" >&2
  exec "$@"
fi

# --- Acquire one of $SLOTS slots. bash 3.2 (macOS): no {fd} allocation, so fds
# --- are assigned explicitly via eval. Cycle all slots with a short per-slot
# --- wait so waiters spread across whichever slot frees first, rather than all
# --- piling onto slot 1.
HELD=""
announced=""
WAIT_MAX="${KEEL_HEAVY_WAIT_MAX:-180}"
case "$WAIT_MAX" in ''|*[!0-9]*) WAIT_MAX=180 ;; esac
started="$(date +%s)"

# Rolling, machine-global CI hand-off budget. Consulted only on wait timeout.
# Held under its own lock so concurrent sessions cannot double-spend one slot of
# budget. Returns 0 (and records the spend) when a hand-off is allowed.
ci_defer_allowed() {
  local budget window ledger now cutoff kept
  budget="${KEEL_CI_DEFER_BUDGET:-3}"
  window="${KEEL_CI_DEFER_WINDOW:-3600}"
  case "$budget" in ''|*[!0-9]*) budget=3 ;; esac
  case "$window" in ''|*[!0-9]*) window=3600 ;; esac
  [ "$budget" -eq 0 ] && return 1
  ledger="$(dirname "$LKDIR")/ci-deferrals"
  now="$(date +%s)"
  cutoff=$((now - window))
  # `exec 198>file` takes NO command word, so EVERY redirection on it applies to
  # the shell PERMANENTLY -- appending `2>/dev/null` here silently sent this
  # script's stderr to /dev/null for the rest of its life, so the hand-off
  # instructions below were written into the void while the exit code still
  # looked right. Pre-create the file quietly instead (the redirect on `:` is
  # scoped to `:`), then open the fd with no redirections attached.
  : > "${ledger}.lock" 2>/dev/null || true
  exec 198>"${ledger}.lock" || return 1
  "$FLOCK" 198 2>/dev/null || return 1
  kept=""
  if [ -f "$ledger" ]; then
    # keep only timestamps still inside the window
    kept="$(awk -v c="$cutoff" '$1+0 > c { print $1 }' "$ledger" 2>/dev/null || true)"
  fi
  spent=0
  [ -n "$kept" ] && spent="$(printf '%s\n' "$kept" | grep -c . || true)"
  if [ "$spent" -ge "$budget" ]; then
    CI_DEFER_SPENT="$spent"; CI_DEFER_BUDGET="$budget"
    exec 198>&-
    return 1
  fi
  { [ -n "$kept" ] && printf '%s\n' "$kept"; echo "$now"; } > "$ledger" 2>/dev/null || true
  CI_DEFER_SPENT=$((spent + 1)); CI_DEFER_BUDGET="$budget"
  exec 198>&-
  return 0
}

while [ -z "$HELD" ]; do
  i=1
  while [ "$i" -le "$SLOTS" ]; do
    fd=$((199 + i))
    if eval "exec ${fd}>\"\$LKDIR/slot.\$i\"" 2>/dev/null; then
      if "$FLOCK" -w 1 "$fd" 2>/dev/null; then
        HELD="$fd"
        break
      fi
      eval "exec ${fd}>&-" 2>/dev/null || true
    fi
    i=$((i + 1))
  done
  [ -n "$HELD" ] && break

  if [ -z "$announced" ]; then
    if [ "$WAIT_MAX" -gt 0 ]; then
      echo "⏳ All $SLOTS heavy-op slots busy — queued (up to ${WAIT_MAX}s, then a CI hand-off is offered)..." >&2
    else
      echo "⏳ All $SLOTS heavy-op slots busy — queued, waiting (this runs locally, it is not refused)..." >&2
    fi
    announced=1
  fi

  if [ "$WAIT_MAX" -gt 0 ] && [ $(( $(date +%s) - started )) -ge "$WAIT_MAX" ]; then
    if ci_defer_allowed; then
      echo "" >&2
      echo "🚚 Slots saturated for ${WAIT_MAX}s — HAND THIS RUN TO CI and move on." >&2
      echo "   Do NOT keep waiting, and do NOT re-run it locally: the point is that" >&2
      echo "   this session proceeds in parallel instead of stalling." >&2
      echo "" >&2
      echo "   Commit and push the branch; let CI run:  $*" >&2
      echo "" >&2
      echo "   CI hand-off budget: ${CI_DEFER_SPENT}/${CI_DEFER_BUDGET} used in the last" >&2
      echo "   ${KEEL_CI_DEFER_WINDOW:-3600}s, machine-wide. Once spent, heavy ops queue" >&2
      echo "   locally again — the cap is deliberate, so the test load does not just" >&2
      echo "   relocate onto CI." >&2
      exit 75
    fi
    # Budget spent -> queue locally after all. Say so once, then stop re-checking.
    echo "⏳ CI hand-off budget spent (${CI_DEFER_SPENT:-?}/${CI_DEFER_BUDGET:-?} in the last ${KEEL_CI_DEFER_WINDOW:-3600}s) — queueing locally instead." >&2
    WAIT_MAX=0
  fi
done

# Bound each op's peak so slots x heap is a predictable ceiling. Appended, so an
# explicit --max-old-space-size already in NODE_OPTIONS wins (last flag applies).
if [ "${KEEL_HEAVY_MAX_HEAP:-2048}" != "0" ]; then
  NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=${KEEL_HEAVY_MAX_HEAP:-2048}"
  export NODE_OPTIONS
fi

# exec `env` so the marker is set AND the held fd is inherited by the real
# command; the slot releases when that command finally exits.
exec env KEEL_HEAVY_LOCK_HELD=1 "$@"
