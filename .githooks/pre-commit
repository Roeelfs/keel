#!/usr/bin/env bash
# Block a commit that adds private facts to this PUBLIC repo: emails, home paths, credential formats, and the
# machine's private denylist (ticket prefixes, customer names). Scans only the staged ADDED lines.
# Activate once per clone: git config core.hooksPath .githooks. Bypass once, and say why: git commit --no-verify
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
command -v python3 >/dev/null 2>&1 || { echo "pre-commit: python3 missing, leak check skipped" >&2; exit 0; }
exec python3 "$root/tooling/leak-check.py" --staged
